# Stripe sandbox/live key from the Stripe Dashboard.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Created by: stripe listen --forward-to https://tracklens.ch/api/stripe-webhook.php
# or copied from the webhook endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional when the TrackLens product/price already exists in Stripe.
# If empty, run scripts/create-tracklens-product.php once.
STRIPE_PRODUCT_ID=
STRIPE_PRICE_ID=

# Public origin only; no trailing slash.
APP_BASE_URL=https://tracklens.ch

# IMPORTANT: absolute path outside the public web root.
# Example on shared hosting: /home/your-user/private/tracklens.sqlite
TRACKLENS_DB_PATH=/absolute/private/path/tracklens.sqlite
